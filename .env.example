# ========================================================
# Configuración de Entorno - QA Platform LLM
# ========================================================
# Copiar este archivo a .env y ajustar los valores locales.
# NUNCA commitear el archivo .env con credenciales reales.

# Entorno de la aplicación (development | testing | production)
APP_ENV=development
PORT=5000

# Clave secreta para firmado criptográfico de sesiones/cookies (Flask session)
SECRET_KEY=development-secret-key-change-in-production

# URL de conexión a la base de datos (SQLite local / PostgreSQL en producción)
DATABASE_URL=sqlite:///qa_platform.db

